# =====================================================================
# Copiar para .env e preencher. .env NÃO vai para o git.
# =====================================================================
# Estes valores são segredos das EDGE FUNCTIONS. Em produção não use .env —
# use `supabase secrets set CHAVE=valor`, que grava no projeto remoto.
# =====================================================================

# =====================================================================
# IA — as três Edge Functions de geração
# =====================================================================
# O provedor é escolhido por variável, em _shared/llm.ts. Dois caminhos:
#
#   anthropic     → API nativa. Schema GARANTIDO pela API + prompt caching
#                   do catálogo. É o padrão.
#   openai-compat → qualquer endpoint compatível com OpenAI: OpenRouter,
#                   OmniRoute auto-hospedado, Together, LM Studio.
#
# Padrão global (vale para as três funções):
LLM_PROVEDOR=anthropic
LLM_MODELO=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------
# Override POR FUNÇÃO. O sufixo é o nome da tarefa em maiúsculas, com
# hífen virando underline. As quatro tarefas existentes:
#   MONTAR_TREINO · MONTAR_ESTUDO_FASE_A · MONTAR_ESTUDO_FASE_B · EXTRAIR_TOPICOS
#
# Exemplo — Claude no que importa, modelo barato no resto:
#
#   LLM_EXTRAIR_TOPICOS_PROVEDOR=openai-compat
#   LLM_EXTRAIR_TOPICOS_MODELO=google/gemma-4-26b-a4b:free
#   LLM_EXTRAIR_TOPICOS_BASE_URL=https://openrouter.ai/api/v1
#   LLM_EXTRAIR_TOPICOS_API_KEY=sk-or-v1-...
#
# `montar-treino` fica no Claude de propósito: roda uma vez por pessoa no
# onboarding, custa ~US$ 0,12, e é a decisão mais importante do fluxo.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Se usar OmniRoute: a BASE_URL precisa ser PÚBLICA e estar no ar quando
# o app chamar. `localhost` não funciona — a Edge Function roda na
# infraestrutura do Supabase, não na sua máquina. Com o host fora do ar,
# a geração cai no fallback de template sem avisar o usuário.
# ---------------------------------------------------------------------
# LLM_BASE_URL=https://seu-omniroute.exemplo.com/v1
# LLM_API_KEY=

# ---------------------------------------------------------------------
# Provedor de RESERVA, por tarefa. Só entra quando o primeiro devolve
# ProvedorIndisponivel (rede, 5xx, 429, timeout) — geração ruim continua
# indo para retry/template, não troca de provedor.
#
# Exemplo — Grok cobrindo a queda do Gemini no montar-treino:
#
#   LLM_MONTAR_TREINO_FALLBACK_PROVEDOR=openai-compat
#   LLM_MONTAR_TREINO_FALLBACK_MODELO=grok-4.6
#   LLM_MONTAR_TREINO_FALLBACK_BASE_URL=https://api.x.ai/v1
#   LLM_MONTAR_TREINO_FALLBACK_API_KEY=xai-...
#
# Os IDs da x.ai são minúsculos e NÃO são o rótulo do seletor da interface
# ("Grok 4.6" no menu = `grok-4.6` na API). Verificados na doc em
# 2026-08-13: grok-4.6 · grok-4.5 · grok-4.3 · grok-build-0.1 ·
# grok-4.20-0309-reasoning · grok-4.20-0309-non-reasoning ·
# grok-4.20-multi-agent-0309. A x.ai suporta response_format json_schema
# nativamente, então o caminho de degradação para schema em prosa não
# dispara — a saída vem garantida pela API.
#
# Configurar a reserva NÃO garante que ela roda: o primário pode gastar o
# prazo antes de falhar. Por isso o primário é limitado a uma fatia do
# orçamento quando existe reserva.
# ---------------------------------------------------------------------
# Fatia máxima do prazo para o provedor PRIMÁRIO quando há reserva.
# Padrão 0.55. Se o primário costuma cair (free tier dando 503) e a
# reserva é um modelo de raciocínio, que precisa de mais tempo, baixe —
# 0.35 dá ~70s dos 110s para a reserva.
# ---------------------------------------------------------------------
# LLM_FATIA_PRIMARIO=0.55

# ---------------------------------------------------------------------
# Esforço de raciocínio por tarefa: low · medium · high · xhigh · max
#
# Vale nos DOIS caminhos: vira `output_config.effort` na Anthropic e
# `reasoning_effort` no compatível (x.ai e Gemini usam o mesmo
# vocabulário). Provedor que não conhece o parâmetro faz o código repetir
# sem ele, sem perder o schema nativo.
#
# ATENÇÃO: na x.ai o padrão é `high` — não mandar nada NÃO significa
# rápido, significa raciocínio longo consumindo o prazo. Para caber no
# orçamento com um provedor lento, mande `low` explicitamente.
#
# O padrão no código para montar-treino é `xhigh` (é a decisão mais
# importante do fluxo, roda uma vez por pessoa). Baixe quando o provedor
# do dia for lento e o plano estiver estourando o prazo — melhor um plano
# bom em 60s que nenhum plano em 150s.
# ---------------------------------------------------------------------
# LLM_MONTAR_TREINO_ESFORCO=low

# ---------------------------------------------------------------------
# Teto de tempo da IA por requisição, em ms. Precisa ser MENOR que o wall
# clock do runtime (150s no plano free): a diferença é a reserva para
# gravar o template de fallback e responder. Estourar o wall clock mata a
# função sem resposta nenhuma, e o cliente vê só "non-2xx status code".
# ---------------------------------------------------------------------
# LLM_ORCAMENTO_MS=110000

# ---------------------------------------------------------------------
# Web Push (VAPID)
# Gerar uma vez:  npx web-push generate-vapid-keys
# A chave PÚBLICA também vai para o cliente, no registro do service worker.
# ---------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ---------------------------------------------------------------------
# Segredo do cron. Precisa ser IDÊNTICO ao gravado no banco:
#
#   insert into private.config (chave, valor)
#   values ('cron_secret', '<mesmo valor daqui>');
#
# É o que autentica o pg_cron chamando `disparar-notificacoes` — a função
# roda com verify_jwt=false porque quem chama é o banco, não um usuário.
# ---------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------
# CORS. Vazio = libera geral (só para dev local).
# Em produção, a URL do PWA. Sem isso, qualquer site chama as funções
# com o token de quem estiver logado.
# ---------------------------------------------------------------------
ORIGENS_PERMITIDAS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------
# Injetadas automaticamente pelo runtime das Edge Functions. Não preencher.
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------
