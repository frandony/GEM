# =====================================================================
# Copiar para .env e preencher. .env NÃO vai para o git.
# =====================================================================
# Estes valores são segredos das EDGE FUNCTIONS. Em produção não use .env —
# use `supabase secrets set CHAVE=valor`, que grava no projeto remoto.
# =====================================================================

# =====================================================================
# IA — as três Edge Functions de geração
# =====================================================================
# O provedor é escolhido por variável, em _shared/llm.ts. Dois caminhos:
#
#   anthropic     → API nativa. Schema GARANTIDO pela API + prompt caching
#                   do catálogo. É o padrão.
#   openai-compat → qualquer endpoint compatível com OpenAI: OpenRouter,
#                   OmniRoute auto-hospedado, Together, LM Studio.
#
# Padrão global (vale para as três funções):
LLM_PROVEDOR=anthropic
LLM_MODELO=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------
# Override POR FUNÇÃO. O sufixo é o nome da tarefa em maiúsculas, com
# hífen virando underline. As quatro tarefas existentes:
#   MONTAR_TREINO · MONTAR_ESTUDO_FASE_A · MONTAR_ESTUDO_FASE_B · EXTRAIR_TOPICOS
#
# Exemplo — Claude no que importa, modelo barato no resto:
#
#   LLM_EXTRAIR_TOPICOS_PROVEDOR=openai-compat
#   LLM_EXTRAIR_TOPICOS_MODELO=google/gemma-4-26b-a4b:free
#   LLM_EXTRAIR_TOPICOS_BASE_URL=https://openrouter.ai/api/v1
#   LLM_EXTRAIR_TOPICOS_API_KEY=sk-or-v1-...
#
# `montar-treino` fica no Claude de propósito: roda uma vez por pessoa no
# onboarding, custa ~US$ 0,12, e é a decisão mais importante do fluxo.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Se usar OmniRoute: a BASE_URL precisa ser PÚBLICA e estar no ar quando
# o app chamar. `localhost` não funciona — a Edge Function roda na
# infraestrutura do Supabase, não na sua máquina. Com o host fora do ar,
# a geração cai no fallback de template sem avisar o usuário.
# ---------------------------------------------------------------------
# LLM_BASE_URL=https://seu-omniroute.exemplo.com/v1
# LLM_API_KEY=

# ---------------------------------------------------------------------
# Web Push (VAPID)
# Gerar uma vez:  npx web-push generate-vapid-keys
# A chave PÚBLICA também vai para o cliente, no registro do service worker.
# ---------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ---------------------------------------------------------------------
# Segredo do cron. Precisa ser IDÊNTICO ao gravado no banco:
#
#   insert into private.config (chave, valor)
#   values ('cron_secret', '<mesmo valor daqui>');
#
# É o que autentica o pg_cron chamando `disparar-notificacoes` — a função
# roda com verify_jwt=false porque quem chama é o banco, não um usuário.
# ---------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------
# CORS. Vazio = libera geral (só para dev local).
# Em produção, a URL do PWA. Sem isso, qualquer site chama as funções
# com o token de quem estiver logado.
# ---------------------------------------------------------------------
ORIGENS_PERMITIDAS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------
# Injetadas automaticamente pelo runtime das Edge Functions. Não preencher.
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------
