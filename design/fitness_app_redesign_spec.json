        { "text": "Próxima série", "style": "primary" }
      ],
      "rest_timer": { "display": "overlay", "duration": 120, "visual": "circular_progress", "sound": true, "vibration": true }
    },
    "profile_settings": {
      "title": "Perfil",
      "layout": "vertical_scroll",
      "sections": [
        {
          "id": "user_card",
          "type": "profile_header",
          "avatar": { "size": 64, "initials": "FV" },
          "name": "francisco de vasconcelos",
          "email": "francisco@email.com",
          "member_since": "2024"
        },
        {
          "id": "stats",
          "type": "stats_grid",
          "items": [
            { "label": "Treinos", "value": 142 },
            { "label": "Dias seguidos", "value": 12 },
            { "label": "Volume total", "value": "45t" }
          ]
        },
        {
          "id": "settings",
          "type": "settings_list",
          "items": [
            { "icon": "user", "label": "Editar perfil", "action": "navigate" },
            { "icon": "bell", "label": "Notificações", "action": "toggle" },
            { "icon": "moon", "label": "Tema escuro", "action": "toggle", "default": true },
            { "icon": "volume", "label": "Sons do app", "action": "toggle" },
            { "icon": "shield", "label": "Privacidade", "action": "navigate" },
            { "icon": "help", "label": "Ajuda e suporte", "action": "navigate" },
            { "icon": "logout", "label": "Sair", "action": "destructive", "color": "#ff453a" }
          ]
        }
      ]
    }
  },
  "interactions": {
    "tap_feedback": { "style": "opacity_pulse", "active_opacity": 0.7, "duration": "100ms" },
    "swipe_actions": {
      "exercise_row": {
        "direction": "left",
        "threshold": 80,
        "actions": [
          { "icon": "edit", "label": "Editar", "color": "#0a84ff", "position": "right" },
          { "icon": "delete", "label": "Excluir", "color": "#ff453a", "position": "right" }
        ]
      }
    },
    "pull_to_refresh": { "indicator": "circular", "color": "#30d158", "background": "transparent" },
    "page_transitions": { "push": "slide_from_right", "pop": "slide_to_right", "duration": "300ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "skeleton_loading": {
      "style": "shimmer",
      "background": "rgba(255,255,255,0.04)",
      "shimmer": "linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent)"
    }
  },
  "accessibility": {
    "minimum_touch_target": 44,
    "contrast_ratio": "WCAG AA (4.5:1 para texto normal)",
    "dynamic_type": "Suportar ajuste de tamanho de fonte do sistema",
    "voice_over": {
      "exercise_row": "{nome do exercício}, {séries} séries de {repetições} repetições, {descanso} de descanso",
      "progress_bar": "{porcentagem}% do treino concluído"
    },
    "reduce_motion": "Respeitar preferência do sistema para animações"
  },
  "implementation_notes": {
    "framework_recommendations": [
      "React Native com Expo para cross-platform",
      "Flutter como alternativa (Material 3 + customização)",
      "SwiftUI para iOS nativo (melhor performance e feel)",
      "Jetpack Compose para Android nativo"
    ],
    "libraries": [
      "Reanimated 3 (React Native) para animações fluidas",
      "React Native Gesture Handler para gestures",
      "Lottie para animações complexas (timer, conclusão)"
    ],
    "performance": [
      "Usar FlatList/SectionList para listas longas de exercícios",
      "Memoizar componentes de exercício para evitar re-renders",
      "Lazy load imagens e ícones",
      "Manter estado do timer no nível mais baixo possível"
    ],
    "data_persistence": [
      "AsyncStorage/SecureStore para preferências",
      "SQLite/Realm para histórico de treinos offline",
      "Sync com backend quando online"
    ]
  }
}
